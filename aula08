# Consulta de Endereço via API ViaCEP
Este script solicita um CEP ao usuário, consulta a API pública ViaCEP e exibe os dados formatados.
"""

import requests

def consultar_cep(cep):
    # Remove caracteres não numéricos
    cep = ''.join(filter(str.isdigit, cep))

    if len(cep) != 8:
        print('Erro: O CEP deve conter exatamente 8 dígitos.')
        return

    url = f'https://viacep.com.br/ws/{cep}/json/'

    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status() # Verifica erros HTTP

        dados = response.json()

        if 'erro' in dados:
            print(f'Erro: O CEP {cep} não foi encontrado.')
        else:
            print('\n--- Informações do Endereço ---')
            print(f"Logradouro: {dados.get('logradouro', 'N/A')}")
            print(f"Bairro:     {dados.get('bairro', 'N/A')}")
            print(f"Cidade/UF:  {dados.get('localidade', 'N/A')} - {dados.get('uf', 'N/A')}")
            print(f"CEP:        {dados.get('cep', 'N/A')}")
            print(f"DDD:        {dados.get('ddd', 'N/A')}")
            print('--------------------------------')

    except requests.exceptions.ConnectionError:
        print('Erro: Não foi possível conectar à API. Verifique sua conexão com a internet.')
    except requests.exceptions.HTTPError as http_err:
        print(f'Erro HTTP: {http_err}')
    except Exception as e:
        print(f'Ocorreu um erro inesperado: {e}')

# Exemplo de uso
cep_input = '01001000' # Exemplo: Praça da Sé, SP
consultar_cep(cep_input)

# Digite o CEP no campo abaixo para realizar a consulta
user_cep = input('Digite o CEP para consulta (somente números): ')
consultar_cep(user_cep)


