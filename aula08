def check_critical_condition(metric_value, critical_threshold):
    """Verifica se o valor da métrica excede o limite crítico."""
    return metric_value > critical_threshold

def trigger_alert(metric_value, critical_threshold):
    """Dispara um alerta, imprimindo uma mensagem no console."""
    print(f"ALERTA CRÍTICO: A temperatura do PC ({metric_value}°C) excedeu o limite ({critical_threshold}°C)!")
    # Em um cenário real, aqui seria enviado um e-mail, SMS, etc.

def main():
    """Função principal para simular a leitura e verificação da métrica com entrada do usuário."""
    # Define o limite crítico para a temperatura do PC
    critical_threshold = 80 # Ex: 80°C é considerado crítico para um PC

    while True:
        try:
            # Solicita ao usuário que insira a temperatura
            user_input = input("Digite a temperatura atual do PC em Celsius (ou 'sair' para encerrar): ")
