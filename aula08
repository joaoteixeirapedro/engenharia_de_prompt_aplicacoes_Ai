        "### Organizador Automático de Arquivos\n",
        "Este script varre uma pasta escolhida e organiza os arquivos em subpastas de acordo com a extensão."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "aa80a9d4",
        "outputId": "ce5aa4be-f447-4826-cdf4-9d3f51675953"
      },
      "source": [
        "import os\n",
        "import shutil\n",
        "\n",
        "def organizar_arquivos(diretorio_alvo):\n",
        "    # Mapeamento de extensões para pastas\n",
        "    extensoes = {\n",
        "        'Imagens': ['.jpg', '.jpeg', '.png', '.gif', '.bmp'],\n",
        "        'Documentos': ['.pdf', '.docx', '.txt', '.xlsx', '.pptx'],\n",
        "        'Audio': ['.mp3', '.wav'],\n",
        "        'Video': ['.mp4', '.mov', '.avi'],\n",
        "        'Compactados': ['.zip', '.rar', '.7z'],\n",
        "        'Scripts': ['.py', '.sh', '.js']\n",
        "    }\n",
        "\n",
        "    # Garante que o caminho existe\n",
        "    if not os.path.exists(diretorio_alvo):\n",
        "        print(f'Erro: O diretório {diretorio_alvo} não existe.')\n",
        "        return\n",
        "\n",
        "    # Itera sobre os arquivos no diretório\n",
        "    for arquivo in os.listdir(diretorio_alvo):\n",
        "        caminho_completo = os.path.join(diretorio_alvo, arquivo)\n",
        "\n",
        "        # Pula se for uma pasta\n",
        "        if os.path.isdir(caminho_completo):\n",
        "            continue\n",
        "\n",
        "        # Extrai a extensão\n",
        "        nome, extensao = os.path.splitext(arquivo)\n",
        "        extensao = extensao.lower()\n",
        "\n",
        "        # Define para qual pasta o arquivo deve ir\n",
        "        pasta_destino = 'Outros'\n",
        "        for categoria, lista_ext in extensoes.items():\n",
        "            if extensao in lista_ext:\n",
        "                pasta_destino = categoria\n",
        "                break\n",
        "\n",
        "        # Cria a pasta de destino se não existir\n",
        "        caminho_pasta_destino = os.path.join(diretorio_alvo, pasta_destino)\n",
        "        if not os.path.exists(caminho_pasta_destino):\n",
        "            os.makedirs(caminho_pasta_destino)\n",
        "\n",
        "        # Move o arquivo\n",
        "        try:\n",
        "            shutil.move(caminho_completo, os.path.join(caminho_pasta_destino, arquivo))\n",
        "            print(f'Movido: {arquivo} -> {pasta_destino}/')\n",
        "        except Exception as e:\n",
        "            print(f'Erro ao mover {arquivo}: {e}')\n",
        "\n",
        "# Exemplo de uso: crie uma pasta de teste ou use uma existente\n",
        "os.makedirs('pasta_teste', exist_ok=True)\n",
        "with open('pasta_teste/documento.pdf', 'w') as f: f.write('teste')\n",
        "with open('pasta_teste/foto.jpg', 'w') as f: f.write('teste')\n",
        "\n",
        "print('Iniciando organização...')\n",
        "organizar_arquivos('pasta_teste')\n",
        "print('Concluído!')"
      ],
