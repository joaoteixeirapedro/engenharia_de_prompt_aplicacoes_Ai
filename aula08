"""### Organizador Automático de Arquivos
Este script varre uma pasta escolhida e organiza os arquivos em subpastas de acordo com a extensão.
"""

import os
import shutil

def organizar_arquivos(diretorio_alvo):
    # Mapeamento de extensões para pastas
    extensoes = {
        'Imagens': ['.jpg', '.jpeg', '.png', '.gif', '.bmp'],
        'Documentos': ['.pdf', '.docx', '.txt', '.xlsx', '.pptx'],
        'Audio': ['.mp3', '.wav'],
        'Video': ['.mp4', '.mov', '.avi'],
        'Compactados': ['.zip', '.rar', '.7z'],
        'Scripts': ['.py', '.sh', '.js']
    }

    # Garante que o caminho existe
    if not os.path.exists(diretorio_alvo):
        print(f'Erro: O diretório {diretorio_alvo} não existe.')
        return

    # Itera sobre os arquivos no diretório
    for arquivo in os.listdir(diretorio_alvo):
        caminho_completo = os.path.join(diretorio_alvo, arquivo)

        # Pula se for uma pasta
        if os.path.isdir(caminho_completo):
            continue

        # Extrai a extensão
        nome, extensao = os.path.splitext(arquivo)
        extensao = extensao.lower()

        # Define para qual pasta o arquivo deve ir
        pasta_destino = 'Outros'
        for categoria, lista_ext in extensoes.items():
            if extensao in lista_ext:
                pasta_destino = categoria
                break

        # Cria a pasta de destino se não existir
        caminho_pasta_destino = os.path.join(diretorio_alvo, pasta_destino)
        if not os.path.exists(caminho_pasta_destino):
            os.makedirs(caminho_pasta_destino)

        # Move o arquivo
        try:
            shutil.move(caminho_completo, os.path.join(caminho_pasta_destino, arquivo))
            print(f'Movido: {arquivo} -> {pasta_destino}/')
        except Exception as e:
            print(f'Erro ao mover {arquivo}: {e}')

# Exemplo de uso: crie uma pasta de teste ou use uma existente
os.makedirs('pasta_teste', exist_ok=True)
with open('pasta_teste/documento.pdf', 'w') as f: f.write('teste')
with open('pasta_teste/foto.jpg', 'w') as f: f.write('teste')

print('Iniciando organização...')
organizar_arquivos('pasta_teste')
print('Concluído!')
